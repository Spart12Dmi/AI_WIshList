# Local Ollama server and model used by the query-planning agent.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
LLM_CONTEXT_TOKENS=4096

# Set to false to skip the local LLM and use the deterministic query planner.
USE_LLM_PLANNER=true
USE_SEMANTIC_VALIDATION=true
# Allow the first model call time to load into GPU memory.
LLM_TIMEOUT_SECONDS=60

# Local account, wishlist, offer and RAG persistence. Never commit this database.
DATABASE_PATH=data/wishlist.sqlite3
SESSION_DAYS=7
# Keep false for localhost HTTP; require true behind HTTPS in deployment.
SECURE_COOKIES=false
MAX_CONCURRENT_SEARCHES=2
# Store extraction time budget (planner/discovery and an in-flight call can add time).
SEARCH_TIMEOUT_SECONDS=180

# Public search does not require an external API key.
STORE_LIMIT=15
SEARCH_BACKENDS=bing,yandex,brave,yahoo
# Cache only discovery URLs; merchant prices are fetched again on every search.
SEARCH_CACHE_TTL_SECONDS=300
STORE_DISCOVERY_RESULT_LIMIT=30
# Store searches are independent; raise this to 15 only if your search provider tolerates it.
STORE_SEARCH_WORKERS=8
PER_STORE_PRODUCT_LIMIT=3
EXTRACTION_WORKERS=6
HTTP_TIMEOUT_SECONDS=8

# Real-browser fallback for JavaScript-rendered product pages.
USE_BROWSER_FALLBACK=true
BROWSER_CANDIDATE_LIMIT=12
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=15000
BROWSER_RENDER_WAIT_MS=1200
